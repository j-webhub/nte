  "detail": {
    "id": "adler",
    "globalStatus": "released",
    "coreMechanicKo": "보호막과 사이클 유도를 담당하는 서포터 겸 서브 딜러입니다. 인벤 데이터베이스는 바이레일 스킬과 울티메이트를 먼저 육성하도록 권합니다.",
    "keySkillNamesEn": {
      "basic": "Deliverance",
      "skill": "Evil's Bane",
      "ultimate": "Tranquility",
      "support": "Pristine Reflection"
    },
    "sourceReviewPatch": "1",
    "voiceActors": {
      "en": "Jacob Craner",
      "ja": "森川智之",
      "zhHans": "王宇航",
      "ko": "심규혁"
    },
    "source": "https://www.prydwen.gg/neverness-to-everness/characters/adler",
    "skillDescriptionsKo": {
      "basic": "최대 5단 연속 공격과 조준 공격으로 적을 공격합니다. 공중 낙하 공격과 극한 회피 반격도 사용할 수 있으며, 기본 공격으로 「업」을 쌓아 바이레일 스킬을 강화합니다.",
      "skill": "「공여 환영」을 소환해 주변 적을 공격하고 지속 피해를 줍니다. 동시에 자신과 아군에게 보호막 「깨달음의 가호」를 부여하며, 축적한 「업」을 소모해 스킬의 직접 피해와 지속 피해를 강화할 수 있습니다.",
      "ultimate": "다섯 「공여」를 소환해 표적을 연속 공격합니다. 적이 하나뿐이면 공격이 추가로 적중합니다.",
      "support": "조준해 압축탄을 발사하고 전방의 적을 공격합니다."
    }
  },
  "setting": {
    "summary": "「에이본」 사람들과 이웃의 신회를 한 몸에 받는 완벽한 집사",
