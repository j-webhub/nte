  "detail": {
    "id": "daffodill",
    "globalStatus": "released",
    "coreMechanicKo": "「통찰」 표식을 쌓아 적을 붕괴시킬 때 추가 붕괴 피해를 주는 브레이커입니다. 인벤 데이터베이스는 붕괴 효과와 기술 강화를 중심으로 육성 정보를 정리합니다.",
    "keySkillNamesEn": {
      "basic": "Still Waters",
      "skill": "Resonance / Echoes",
      "ultimate": "Finale",
      "support": "Crossed Blades"
    },
    "sourceReviewPatch": "1",
    "voiceActors": {
      "en": "Natalie Van Sistine",
      "ja": "大原さやか",
      "zhHans": "陈彦亦",
      "ko": "이명호"
    },
    "source": "https://www.prydwen.gg/neverness-to-everness/characters/daffodil",
    "skillDescriptionsKo": {
      "basic": "연속 공격과 차지 돌진·회전 공격으로 적을 몰아붙입니다. 회피로 연속 공격 흐름을 이어갈 수 있고, 공중 낙하 공격과 극한 회피 반격도 사용합니다.",
      "skill": "파티원이 지원 스킬을 사용할 때 공명 자원을 얻으며, 최대 두 번까지 저장합니다. 지원 스킬을 더 사용해 강화된 바이레일 스킬을 발동하면 피해와 붕괴 성능이 높아지고, 자원이 가득 찬 뒤에는 「메아리」 공격으로 전환됩니다.",
      "ultimate": "자신을 강화하고 적에게 「통찰」을 부여합니다. 상태 중 환영 보법을 사용할 수 있으며, 강화된 이동 공격과 회피를 이어가 적을 공격합니다.",
      "support": "검을 휘둘러 전방의 적을 공격합니다."
    },
    "skillNamesKo": {
      "basic": "잔잔한 수면",
      "skill": "공명",
      "ultimate": "피날레 장식",
      "support": "극한 교차"
    }
  },
  "setting": {
    "summary": "말수 적고 무뚝뚝한 「에이본」 전속 보디가드",
    "birthday": "1월 19일",
