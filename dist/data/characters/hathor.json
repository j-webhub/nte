  "detail": {
    "id": "hathor",
    "globalStatus": "released",
    "coreMechanicKo": "「스피드퀵」을 쌓아 울티메이트 에너지를 모으고, 「긴급 배송」 중 연속 바이레일 스킬로 화력을 내는 딜러입니다.",
    "keySkillNamesEn": {
      "basic": "Rapid Delivery",
      "skill": "Aerial Command / Cyclone Strike",
      "ultimate": "Rider Express",
      "support": "Impact Point Designation"
    },
    "sourceReviewPatch": "1",
    "voiceActors": {
      "en": "Allegra Clark",
      "ja": "市ノ瀬加那",
      "zhHans": "洪海天",
      "ko": "이다은"
    },
    "source": "https://www.prydwen.gg/neverness-to-everness/characters/hathor",
    "skillDescriptionsKo": {
      "basic": "연속 공격과 차지 공격으로 적을 공격하고 공중 낙하 공격과 극한 회피 반격도 사용합니다. 공격과 전투 행동으로 「스피드퀵」을 쌓습니다.",
      "skill": "「공중 지령」으로 이동하며 적을 공격하고 「스피드퀵」을 쌓습니다. 길게 눌러 목표를 지정해 강화 공격을 준비할 수 있으며, 「긴급 배송」이 활성화되면 「싸이클론 스트라이크」로 연속 돌진 공격을 가하고 방어 효과를 얻습니다.",
      "ultimate": "익스프레스 상태에 진입해 이동과 공격을 강화하고 바이레일 스킬을 강화합니다. 「스피드퀵」 축적 상태가 강화 효과에 반영되며, 캐릭터를 교체하면 상태가 종료됩니다.",
      "support": "두 차례 발차기로 적을 공격합니다."
    },
    "skillNamesKo": {
      "basic": "초스피드 배송",
      "skill": "공중 지령",
      "ultimate": "라이더 익스프레스",
      "support": "조준 낙하"
    }
  },
  "setting": {
    "summary": "임무 일정표를 작성하고 철저하게 실행에 옮기는 높은 효율성의 배송원",
    "birthday": "8월 29일",
    "faction": "스테리 익스프레스",
