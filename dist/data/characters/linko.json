  "detail": {
    "id": "linko",
    "globalStatus": "released",
    "coreMechanicKo": "파티원의 바이레일 스킬에 반응하는 동기화 협공과 공명 영역으로 파티 피해를 지원하는 령 속성 서브 딜러입니다.",
    "keySkillNamesEn": {
      "basic": "Poltergeist CQC",
      "skill": "Full-Frequency Pulse",
      "ultimate": "Oversync",
      "support": "Spectral Cross"
    },
    "sourceReviewPatch": "1.3",
    "voiceActors": {
      "en": "Emi Lo; Salli Saffioti",
      "ja": "小倉唯; 村瀬迪与",
      "zhHans": "胡影佳; 洪海天",
      "ko": "김서현; 김예림"
    },
    "source": "https://www.prydwen.gg/neverness-to-everness/characters/linko",
    "skillDescriptionsKo": {
      "basic": "연속 공격과 극한 회피 반격으로 공명 자원을 쌓습니다. 사다의 공격 표식이 남은 적을 공격하거나 사다의 공격이 적중해도 전투 흐름에 공명 자원이 더해집니다.",
      "skill": "「전대역 공진」으로 여러 차례 공격하고, 지정한 팀원 한 명 또는 사다를 연계 공격에 참여시킵니다. 축적한 공명 자원이 많을수록 아군에게 제공하는 강화 효과가 커지며, 사다의 위치에 따라서도 강화 단계가 달라집니다.",
      "ultimate": "「과부하 공명」 영역을 만들고 연결된 팀원들의 스킬 사용 흐름에 맞춰 연계 공격을 실행합니다. 영역 안에서 발생한 연계 공격은 링코의 추가 공격을 동반하며, 영역이 끝날 때 축적된 소음을 방출합니다.",
      "support": "「악령 레프트 잽!」으로 공격합니다. 표식 제거, 바이레일 스킬 또는 울티메이트 사용으로 연계 공격을 발동할 수 있습니다."
    }
  },
  "setting": {
    "summary": "만물의 「전파」 를 들을 수 있는 소녀, 줄여서 전파계 소녀다.",
    "birthday": "2월 14일",
    "faction": "E.T.D 6팀 대원",
    "ability": "「텔레파시」"
  },
  "introduction": {
    "introKo": "ETD-6의 막내 링코는 이상체와 함께 사건을 추적한다. 주파수처럼 주변의 존재를 감지하는 독특한 이능력과 직감을 지녔다.",
    "sourceUrl": "https://gamers4.life/neverness-to-everness/database/en/espers/esper-1072/"
  },
  "mechanics": {
    "id": "linko",
    "nameKo": "링코",
    "level80BaseStats": {
      "hp": 15514,
      "atk": 652,
      "def": 921,
      "critRatePct": 5,
      "critDamagePct": 50
    },
    "awakeningEffectsKo": [
      "A1: 링코가 필드 밖에 있을 때 「악령 섬격!」 발생 간격이 25% 짧아진다.",
      "A2: 「울티메이트: 과부하 공명」의 령속성 폭발 피해 배율이 30% 증가한다.",
      "A3: 울티메이트 사용 시 「전대역 공진」의 쿨타임을 초기화한다.",
      "A4: 「공명 영역」에서 「동기화 협공」이 발동할 때마다 광역 령속성 피해를 추가로 준다. 현재 울티메이트 레벨 기준 배율은 199%다.",
      "A5: 「전대역 공진」으로 발동한 「동기화 협공」으로 사이클을 발동할 수 있다. 링코와 선택한 팀원이 사이클을 발동할 수 없는 경우 해당 협공 피해가 50% 증가한다.",
      "A6: 파티원의 「동기화 협공」 치명 확률이 25% 증가한다. 협공 후 링코와 해당 팀원이 울티메이트 에너지를 획득한다."
    ],
    "resonanceKo": {
      "3": "서포트 스킬, 바이레일 스킬, 울티메이트 레벨이 1 상승하고 링코의 공격력이 20% 증가한다.",
      "6": "「공명 영역」 지속시간이 5초 늘어난다. 지속시간 동안 파티 전체의 령 속성 및 주 속성 피해가 30% 증가한다."
    },
    "sourceUrl": "https://nte.inven.co.kr/db/esper/23",
    "notes": "2026-10-06 국내 한국어 자료를 기준으로 스킬명·각성 효과를 대조했습니다. 국내 원문에서 확인할 수 없는 레벨별 계수는 표시하지 않습니다.",
    "awakeningNamesKo": {
      "A1": "만물의 채널 수신 중!",
      "A2": "유령이 얼마나 귀여운데!",
      "A3": "고립된 섬들을 이어줘!",
      "A4": "별들도 소곤소곤 속삭여!",
      "A5": "전 대역을 향해 사랑을 외쳐!",
      "A6": "온 세상의 메아리를 받아라!"
    }
