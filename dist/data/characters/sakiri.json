  "detail": {
    "id": "sakiri",
    "globalStatus": "released",
    "coreMechanicKo": "적을 모으고 약한 적을 삼키며 아군을 강화하는 서포터입니다. 인벤 데이터베이스는 울티메이트와 바이레일 스킬을 우선 육성하도록 안내합니다.",
    "keySkillNamesEn": {
      "basic": "Kiroumaru Headbutt",
      "skill": "Devour Whole",
      "ultimate": "Feast of Gluttony",
      "support": "Squash!"
    },
    "sourceReviewPatch": "1",
    "voiceActors": {
      "en": "Brianna Knickerbocker",
      "ja": "伊藤美来",
      "zhHans": "蔡书瑾",
      "ko": "김나율"
    },
    "source": "https://www.prydwen.gg/neverness-to-everness/characters/sakiri",
    "skillDescriptionsKo": {
      "basic": "연속 공격으로 적을 공격합니다. 길게 눌러 「섭식 모드」에 들어가 키로마루를 타고 싸우며, 공중 낙하 공격과 극한 회피 반격도 사용합니다.",
      "skill": "짧게 누르면 적을 끌어당기고 넘어뜨리는 공격을 합니다. 길게 누르면 적을 빨아들인 뒤 중력으로 들어 올립니다. 강한 적은 들어 올릴 수 없습니다.",
      "ultimate": "거대한 식사를 통해 적에게 피해를 주고, 사키리의 기본 공격력에 비례해 공격력을 높입니다.",
      "support": "키로마루가 발을 굴러 적을 공격합니다."
    }
  },
  "setting": {
    "summary": "겉보기에도 실제로도 만만치 않은 「에이본」의 독보적 존재",
    "birthday": "11월 7일",
    "faction": "에이본 골동품 가게",
    "ability": "「유령 잡기 게임」"
  },
  "introduction": {
    "introKo": "에이본에서 실력으로는 누구도 따라오지 못하며, 생김새만큼이나 무섭다는 평을 듣는다.",
    "sourceUrl": "https://nte.hq1.pro/en/characters/sakiri-1003"
  },
